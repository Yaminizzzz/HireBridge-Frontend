<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📄 Terms and Conditions"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Intro -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome to HireBridge. By accessing or using our application, you agree to comply with the following terms and conditions. Please read them carefully."
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <!-- 1. Eligibility -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Eligibility"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Job seekers must provide accurate personal and professional details while registering.\n• Employers must register using a valid company email and provide true information about job postings."
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <!-- 2. User Responsibilities -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. User Responsibilities"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Users are responsible for maintaining the confidentiality of their login credentials.\n• Any misuse of the platform, including posting false information or inappropriate content, may result in account suspension.\n• Job seekers must ensure that resumes and profiles are truthful and not misleading.\n• Employers must ensure that job vacancies posted are genuine and not fraudulent."
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <!-- 3. Resume & Job Applications -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Resume &amp; Job Applications"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• By uploading your resume, you agree that it may be shared with employers registered on HireBridge.\n• Applicants must ensure that all provided details are current and correct."
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
