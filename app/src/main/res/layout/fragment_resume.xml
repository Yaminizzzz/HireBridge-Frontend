<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Back + Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESUME"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <!-- Import Resume -->
        <TextView
            android:id="@+id/tvImport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Import your Resume"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We will scan your resume and pre-fill sections to help you save time"
            android:textSize="14sp"
            android:paddingBottom="10dp" />

        <!-- Upload Resume Button -->
        <Button
            android:id="@+id/btnUploadResume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/holo_green_light"
            android:text="Upload Resume"
            android:textAllCaps="false"
            android:textColor="@android:color/black" />

        <!-- Note -->
        <TextView
            android:id="@+id/tvNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/holo_orange_light"
            android:padding="8dp"
            android:text="This is the resume which employers will see when you apply. Please make sure it is up to date"
            android:textSize="12sp" />

        <!-- Profile Info -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yamini"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingTop="12dp" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="yaminisankar011@gmail.com"
            android:textColor="@android:color/holo_blue_dark" />

        <TextView
            android:id="@+id/tvPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9894821831" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chennai"
            android:paddingBottom="12dp" />

        <!-- Sections -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAREER OBJECTIVE"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAddObjective"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add your career objective"
            android:textColor="@android:color/holo_green_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EDUCATION"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/tvAddEducation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add Education"
            android:textColor="@android:color/holo_green_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WORK EXPERIENCE"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/tvAddJob"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add job"
            android:textColor="@android:color/holo_green_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SKILLS"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/tvAddSkill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add Skill"
            android:textColor="@android:color/holo_green_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PORTFOLIO/WORK SAMPLES"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/tvAddPortfolio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add Portfolio/ worksamples"
            android:textColor="@android:color/holo_green_dark"
            android:paddingBottom="16dp" />

        <!-- Proceed Button -->
        <Button
            android:id="@+id/btnProceed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/holo_green_dark"
            android:text="Proceed to Application"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
