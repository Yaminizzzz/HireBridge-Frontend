<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JOB DETAILS"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Job Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@android:color/darker_gray"
            android:backgroundTint="#EAF4FF"
            android:layout_marginBottom="12dp"
            android:elevation="4dp">

            <!-- Actively Hiring -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actively Hiring"
                android:textColor="#1EB980"
                android:textStyle="bold"
                android:background="#CCF5E1"
                android:padding="4dp"
                android:textSize="12sp" />

            <!-- Job Title -->
            <TextView
                android:id="@+id/tvJobTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UI/UX Design"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginTop="8dp" />

            <!-- Company & Location -->
            <TextView
                android:id="@+id/tvCompany"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Growedin Group\nYeshwanthpur, Bangalore"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <!-- Date -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8th August 2025"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <!-- Experience, Salary, Applicants -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvExperience"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1 year(s) experience"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSalary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="₹ 40,000/month"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvApplied"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="700 applied"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Vacancies and Early Applicant -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvVacancies"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="15 vacancies"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvEarlyApplicant"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Be an early applicant"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Applied Status -->
            <TextView
                android:id="@+id/tvAppliedStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Applied"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:background="@android:color/holo_green_dark"
                android:padding="8dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- About Job -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About Job"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <!-- Responsibilities -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Key Responsibilities:"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvResponsibilities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:text="1. Define the creative vision for UI design projects and oversee their execution&#10;
2. Mentor and guide junior designers, providing support and training to enhance their skills&#10;
3. Ensure that designs meet client requirements, quality standards, and deadlines&#10;
4. Review and improve designs made by junior designers, providing constructive feedback for improvement&#10;
5. Conduct regular training sessions and workshops to foster skill development and creativity within the design team&#10;
6. Work closely with the client servicing team to understand client requirements and ensure designs align with expectations." />

    </LinearLayout>
</ScrollView>
