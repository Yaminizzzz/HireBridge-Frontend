<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Education"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:paddingBottom="16dp" />

    <!-- Education Options -->
    <TextView
        android:id="@+id/tvGraduation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ Add graduation / Post Graduation"
        android:textSize="16sp"
        android:textColor="@android:color/holo_green_dark"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tvSeniorSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ Add Senior Secondary (XII)"
        android:textSize="16sp"
        android:textColor="@android:color/holo_green_dark"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tvSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ Add Secondary (X)"
        android:textSize="16sp"
        android:textColor="@android:color/holo_green_dark"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tvDiploma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ Add Diploma"
        android:textSize="16sp"
        android:textColor="@android:color/holo_green_dark"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tvPhd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ Add PHD"
        android:textSize="16sp"
        android:textColor="@android:color/holo_green_dark"
        android:paddingBottom="12dp" />

</LinearLayout>
