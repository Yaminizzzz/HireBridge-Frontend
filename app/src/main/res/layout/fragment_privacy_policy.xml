<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 Privacy Policy"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Intro -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="App Name: HireBridge\n\nAt HireBridge, your privacy is very important to us. This Privacy Policy explains how we collect, use, and protect your information when you use our application."
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Section 1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Information We Collect"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Job Seekers: Name, email address, resume, skills, experience, and other details you provide.\n• Employers: Company name, official email, job postings, and other recruitment-related details.\n• Usage Data: Device information, app usage logs, and interaction data for improving services."
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Section 2 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. How We Use Your Information"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• To create and manage your account.\n• To allow job seekers to apply for jobs and employers to manage applications.\n• To communicate updates, notifications, and important alerts.\n• To improve our services and user experience."
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Section 3 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Data Sharing"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Job seekers' resumes and profiles are shared only with registered employers.\n• We do not sell or rent your personal information to third parties.\n• Data may be shared when required by law or to protect our users."
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
