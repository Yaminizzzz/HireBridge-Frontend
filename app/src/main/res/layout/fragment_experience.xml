<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF"
    android:scrollbars="none"> <!-- 👈 hides the scrollbar -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Designation -->
        <EditText
            android:id="@+id/etDesignation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Software Engineer"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <!-- Profile -->
        <EditText
            android:id="@+id/etProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Operations"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <!-- Location -->
        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Mumbai"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <!-- Is work from home -->
        <CheckBox
            android:id="@+id/cbWorkFromHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Is work from home"
            android:layout_marginBottom="10dp" />

        <!-- Start Date and End Date Labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start Date"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="End Date"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Start Date and End Date Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnStartDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select Start Date"
                android:backgroundTint="#6A1B9A"
                android:textColor="@android:color/white"
                android:layout_marginEnd="5dp" />

            <Button
                android:id="@+id/btnEndDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select End Date"
                android:backgroundTint="#6A1B9A"
                android:textColor="@android:color/white"
                android:layout_marginStart="5dp" />
        </LinearLayout>

        <!-- Currently working here -->
        <CheckBox
            android:id="@+id/cbCurrentWork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Currently working here"
            android:layout_marginBottom="10dp" />

        <!-- Description Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description (Optional)"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="5dp" />

        <!-- Protip -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Protip:\n1. Mention key job responsibilities and measurable impact.\n2. Use action verbs.\n3. Include numbers or percentages wherever possible."
            android:textSize="14sp"
            android:padding="8dp"
            android:background="#EEEEEE"
            android:textColor="#444444"
            android:layout_marginBottom="10dp" />

        <!-- Description Field -->
        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:hint="Write your description here..."
            android:layout_marginBottom="20dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveResume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save"
            android:backgroundTint="#6A1B9A"
            android:textColor="@android:color/white"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
