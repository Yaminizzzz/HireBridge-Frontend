<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvAboutTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ABOUT"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome to HireBridge, a smart job portal designed to connect talented job seekers with trusted employers. Our mission is to simplify the hiring process by creating a direct and transparent platform for both candidates and companies."
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👩‍💼 For Job Seekers"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Create your profile and upload your resume.\n• Explore job opportunities that match your skills.\n• Apply directly to companies and track your application status.\n• Get notified when employers accept or reject your application.\n• Connect with companies to proceed with interviews and further steps."
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏢 For Employers"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Register with your official company email.\n• Post job vacancies and manage listings easily.\n• Review applicants’ resumes and shortlist the best candidates.\n• Accept or reject applications with just a click.\n• Find the right talent faster and more efficiently."
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>
</ScrollView>
